; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spideys of the Multiverse"
config/description="Swing through a comic-book city and smash the Glitch-Bots!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.16, 0.03, 0.24, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://assets/ui/icon.png"

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Fx="*res://scripts/fx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/luckiest-guy.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.08, 0.02, 0.12, 1)

[shader_globals]

sun_dir={
"type": "vec3",
"value": Vector3(0.55, 0.42, 0.72)
}
sun_color={
"type": "color",
"value": Color(1, 0.86, 0.78, 1)
}
shade_color={
"type": "color",
"value": Color(0.36, 0.27, 0.62, 1)
}
rim_color={
"type": "color",
"value": Color(0.2, 0.95, 1, 1)
}
rim_color_b={
"type": "color",
"value": Color(1, 0.25, 0.7, 1)
}
fog_color={
"type": "color",
"value": Color(0.62, 0.3, 0.6, 1)
}
fog_color_high={
"type": "color",
"value": Color(0.36, 0.2, 0.55, 1)
}
sky_top={
"type": "color",
"value": Color(0.1, 0.05, 0.26, 1)
}
sky_mid={
"type": "color",
"value": Color(0.45, 0.14, 0.52, 1)
}
sky_horizon={
"type": "color",
"value": Color(1, 0.42, 0.45, 1)
}
fog_start={
"type": "float",
"value": 90.0
}
fog_end={
"type": "float",
"value": 430.0
}
dot_size={
"type": "float",
"value": 5.0
}
noir={
"type": "float",
"value": 0.0
}
world_time={
"type": "float",
"value": 0.0
}
portal_dir={
"type": "vec3",
"value": Vector3(0.1, 0.55, -0.83)
}
portal_power={
"type": "float",
"value": 1.0
}
